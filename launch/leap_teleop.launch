<?xml version="1.0" ?>
<launch>
  
  <arg name="imitation_mode"  default="$(optenv IMITATION_MODE demo_teleop)"/>
  <arg name="leap_ns"         default= "/leapmotion" />    
  <arg name="hand_ns"         default= "/inspire_hand" /> 
  <arg name="hand_side"       default="right" /> <!-- right/left -->
  <arg name="rate"            default="100" /> <!-- rate in Hz -->
  <arg name="param_file"      default="$(find inspire_hand_teleop)/config/default.yaml" /> <!-- path to the parameter file -->
  <arg name="namespace"       default="inspire_hand_teleop" /> <!-- namespace for the hand controller -->
  <arg name="output"          default="screen" /> <!-- screen/log -->
  
  <group ns="$(arg namespace)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="teleop_source" value="$(eval 'leap_teleop' if imitation_mode == 'demo_teleop' else 'lerobot')" />
    <param name="hand_side" value="$(arg hand_side)" />
    <param name="rate" value="$(arg rate)" />
    <param name="leap_ns" value="$(arg leap_ns)" />
    <param name="hand_ns" value="$(arg hand_ns)" />

    <!-- Leap to Inspire Hand teleop node (only launched for data collection or demo mode) -->
    <node name="leap_to_$(arg hand_side)_hand" pkg="inspire_hand_teleop" type="leap_to_inspire_hand.py" output="screen" unless="$(eval imitation_mode == 'inference')" />

    <!-- Teleop controller node (takes control commands coming from direct leap teleoperation or model inference) -->
    <node name="$(arg hand_side)_hand_teleop" pkg="inspire_hand_teleop" type="teleop_inspire_hand_controller.py" output="screen"/>
  </group>
 
</launch>
